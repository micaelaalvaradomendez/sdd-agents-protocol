#!/usr/bin/env bash
# ==============================================================================
# scripts/sdd
# CLI Unificado para el Protocolo SDD (Spec-Driven Development) de Agentes
# ==============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

SESSION_LOCK_FILE="$ROOT_DIR/SESSION_LOCK.md"
INDEX_FILE="$ROOT_DIR/DECISIONS-INDEX.md"
DATA_DIR="$ROOT_DIR/data"

# Colores de salida
CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # Sin color

help_menu() {
  cat <<EOF
${CYAN}======================================================================
 SDD CLI — Protocolo de Desarrollo Guiado por Especificaciones
======================================================================${NC}
Uso: sdd <comando> [argumentos]

${YELLOW}Comandos de Gestión de Sesión y Concurrencia:${NC}
  lock <modulo> <tarea> [agent-id]  Adquiere un bloqueo de sesión en SESSION_LOCK.md
  unlock [agent-id] [modulo]        Libera la sesión activa registrando la hora de fin
  status                            Muestra las sesiones activas y bloqueos vigentes

${YELLOW}Comandos de Calidad y Gobernanza:${NC}
  check                             Ejecuta validación completa de skills y drift de constitución
  sync                              Regenera CONSTITUCION.md desde las skills
  adr "<Título de la decisión>"     Crea un nuevo registro de decisión de arquitectura (ADR)
  detect                            Detecta de forma agnóstica el stack del repositorio actual

${YELLOW}Comandos de Configuración y Automatización:${NC}
  hook install                      Instala el pre-commit hook automático en Git
  init <directorio-destino>         Instala la arquitectura SDD en un proyecto nuevo

Ejemplos:
  ./scripts/sdd lock "api/orders" "Implementar outbox" "Agent-Dev"
  ./scripts/sdd unlock "Agent-Dev" "api/orders"
  ./scripts/sdd adr "Adopción de UUIDv7"
  ./scripts/sdd check
EOF
}

cmd_status() {
  echo -e "${CYAN}=== Estado de Sesiones en SESSION_LOCK.md ===${NC}"
  if [[ ! -f "$SESSION_LOCK_FILE" ]]; then
    echo "No existe el archivo $SESSION_LOCK_FILE"
    exit 1
  fi
  grep -E "\|.*\|" "$SESSION_LOCK_FILE" | grep -v "AgentID" | grep -v ":---" || echo "No hay registros de sesión."
}

cmd_lock() {
  local module="${1:-}"
  local task="${2:-}"
  local agent_id="${3:-${SDD_AGENT_ID:-Agent-Dev}}"

  if [[ -z "$module" || -z "$task" ]]; then
    echo -e "${RED}Error: Debe especificar módulo y tarea.${NC}" >&2
    echo "Uso: sdd lock <modulo> <tarea> [agent-id]" >&2
    exit 1
  fi

  # Verificar si el módulo ya está bloqueado
  if grep -q "| \`.*\` | \`$module\` | .* | - | 🔒 Bloqueado |" "$SESSION_LOCK_FILE" 2>/dev/null; then
    echo -e "${RED}❌ CONFLICTO: El módulo '$module' ya se encuentra bloqueado (🔒).${NC}" >&2
    echo "Debe coordinar con el agente activo o esperar su liberación." >&2
    exit 1
  fi

  local now_utc
  now_utc=$(date -u +"%Y-%m-%d %H:%M")

  # Crear temporal con la nueva fila insertada tras la cabecera de la tabla
  local temp_file
  temp_file=$(mktemp)

  local new_row="| \`$agent_id\` | \`$module\` | $now_utc | - | 🔒 Bloqueado | $task |"

  awk -v row="$new_row" '
    /\| :--- \| :--- \|/ {
      print $0
      print row
      next
    }
    { print }
  ' "$SESSION_LOCK_FILE" > "$temp_file"

  mv "$temp_file" "$SESSION_LOCK_FILE"
  echo -e "${GREEN}✅ Bloqueo adquirido con éxito:${NC}"
  echo "   Agente : $agent_id"
  echo "   Módulo : $module"
  echo "   Tarea  : $task"
  echo "   Hora   : $now_utc UTC"
}

cmd_unlock() {
  local agent_id="${1:-${SDD_AGENT_ID:-}}"
  local module="${2:-}"
  local now_utc
  now_utc=$(date -u +"%Y-%m-%d %H:%M")

  local temp_file
  temp_file=$(mktemp)

  # Buscar la fila bloqueada y actualizarla a liberada con hora fin
  local updated=0
  while IFS= read -r line; do
    if [[ "$line" =~ 🔒\ Bloqueado ]]; then
      local match=1
      if [[ -n "$agent_id" ]] && ! echo "$line" | grep -q "\`$agent_id\`"; then
        match=0
      fi
      if [[ -n "$module" ]] && ! echo "$line" | grep -q "\`$module\`"; then
        match=0
      fi

      if [[ $match -eq 1 && $updated -eq 0 ]]; then
        # Reemplazar "- | 🔒 Bloqueado |" por "$now_utc | ✅ Liberado |"
        line=$(echo "$line" | sed "s/| - | 🔒 Bloqueado |/| $now_utc | ✅ Liberado |/")
        updated=1
      fi
    fi
    echo "$line" >> "$temp_file"
  done < "$SESSION_LOCK_FILE"

  mv "$temp_file" "$SESSION_LOCK_FILE"

  if [[ $updated -eq 1 ]]; then
    echo -e "${GREEN}✅ Sesión liberada con éxito a las $now_utc UTC.${NC}"
  else
    echo -e "${YELLOW}⚠️ No se encontró ninguna sesión activa bloqueada para liberar.${NC}"
  fi
}

cmd_check() {
  echo -e "${CYAN}Ejecutando validación integral SDD...${NC}"
  "$SCRIPT_DIR/validate-skills.sh"
  
  echo ""
  echo "Verificando sincronización de constitución..."
  "$SCRIPT_DIR/sync-constitution.sh"
  
  if ! git -C "$ROOT_DIR" diff --quiet CONSTITUCION.md 2>/dev/null; then
    echo -e "${RED}❌ Drift detectado: CONSTITUCION.md no estaba sincronizada. Se ha regenerado.${NC}" >&2
    exit 1
  fi
  echo -e "${GREEN}✅ Todas las validaciones pasaron exitosamente. Repositorio en regla.${NC}"
}

cmd_sync() {
  "$SCRIPT_DIR/sync-constitution.sh"
}

cmd_adr() {
  if [[ $# -lt 1 ]]; then
    echo -e "${RED}Error: Debe proveer un título para el ADR.${NC}" >&2
    exit 1
  fi
  "$SCRIPT_DIR/new-decision.sh" "$1"
}

cmd_detect() {
  local target="${1:-.}"
  local matrix_file="$DATA_DIR/tech-stack-detection.json"
  
  echo -e "${CYAN}Detectando stack tecnológico en: $target${NC}"
  if [[ ! -f "$matrix_file" ]]; then
    echo "Error: Matriz de stacks no encontrada en $matrix_file" >&2
    exit 1
  fi

  local detected=0
  # Inspección de indicadores clave
  if [[ -f "$target/package.json" ]]; then
    echo -e "${GREEN}  ✓ Detectado ecosistema: Node.js / TypeScript (package.json)${NC}"
    detected=1
  fi
  if [[ -f "$target/go.mod" ]]; then
    echo -e "${GREEN}  ✓ Detectado ecosistema: Go (go.mod)${NC}"
    detected=1
  fi
  if [[ -f "$target/pyproject.toml" || -f "$target/requirements.txt" ]]; then
    echo -e "${GREEN}  ✓ Detectado ecosistema: Python (pyproject.toml / requirements.txt)${NC}"
    detected=1
  fi
  if [[ -f "$target/Cargo.toml" ]]; then
    echo -e "${GREEN}  ✓ Detectado ecosistema: Rust (Cargo.toml)${NC}"
    detected=1
  fi
  if [[ -f "$target/composer.json" ]]; then
    echo -e "${GREEN}  ✓ Detectado ecosistema: PHP (composer.json)${NC}"
    detected=1
  fi
  if [[ -f "$target/pom.xml" || -f "$target/build.gradle" ]]; then
    echo -e "${GREEN}  ✓ Detectado ecosistema: Java / JVM (pom.xml / build.gradle)${NC}"
    detected=1
  fi

  if [[ $detected -eq 0 ]]; then
    echo -e "${YELLOW}  ⚠️ No se detectó un stack estándar conocido. Stack genérico.${NC}"
  fi
}

cmd_hook_install() {
  local git_dir
  git_dir=$(git -C "$ROOT_DIR" rev-parse --git-dir 2>/dev/null || true)
  if [[ -z "$git_dir" ]]; then
    echo -e "${RED}Error: No se encontró directorio .git en $ROOT_DIR${NC}" >&2
    exit 1
  fi

  # Asegurar ruta absoluta a .git
  if [[ "$git_dir" != /* ]]; then
    git_dir="$ROOT_DIR/$git_dir"
  fi

  mkdir -p "$git_dir/hooks"
  local hook_file="$git_dir/hooks/pre-commit"
  cat <<'EOF' > "$hook_file"
#!/usr/bin/env bash
# SDD Pre-commit verification hook
set -euo pipefail
REPO_ROOT="$(git rev-parse --show-toplevel)"
if [[ -x "$REPO_ROOT/scripts/sdd" ]]; then
  echo "🔍 [SDD Hook] Verificando estándares y constitución..."
  "$REPO_ROOT/scripts/sdd" check
fi
EOF
  chmod +x "$hook_file"
  echo -e "${GREEN}✅ Pre-commit hook instalado en $hook_file.${NC}"
  echo "Cada git commit validará automáticamente skills y constitución."
}

cmd_init() {
  local target="${1:-}"
  if [[ -z "$target" ]]; then
    echo -e "${RED}Error: Debe especificar directorio destino.${NC}" >&2
    echo "Uso: sdd init <directorio-destino>" >&2
    exit 1
  fi
  "$SCRIPT_DIR/bootstrap.sh" --target "$target"
}

# Despachador principal
if [[ $# -eq 0 ]]; then
  help_menu
  exit 0
fi

action="$1"
shift

case "$action" in
  lock)
    cmd_lock "$@"
    ;;
  unlock)
    cmd_unlock "$@"
    ;;
  status)
    cmd_status "$@"
    ;;
  check)
    cmd_check "$@"
    ;;
  sync)
    cmd_sync "$@"
    ;;
  adr)
    cmd_adr "$@"
    ;;
  detect)
    cmd_detect "$@"
    ;;
  hook)
    if [[ "${1:-}" == "install" ]]; then
      cmd_hook_install
    else
      echo "Uso: sdd hook install" >&2
      exit 1
    fi
    ;;
  init)
    cmd_init "$@"
    ;;
  help|--help|-h)
    help_menu
    ;;
  *)
    echo -e "${RED}Comando desconocido: $action${NC}" >&2
    help_menu
    exit 1
    ;;
esac
