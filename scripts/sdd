#!/usr/bin/env bash
# ==============================================================================
# scripts/sdd
# CLI Unificado y Autosuficiente para el Protocolo SDD (Spec-Driven Development)
# ==============================================================================

set -euo pipefail

# Determinar directorio raíz del repositorio de forma robusta
SCRIPT_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "$SCRIPT_PATH/AGENTS.md" ]]; then
  ROOT_DIR="$SCRIPT_PATH"
else
  ROOT_DIR="$(cd "$SCRIPT_PATH/.." && pwd)"
fi

SESSION_LOCK_FILE="$ROOT_DIR/SESSION_LOCK.md"
CONSTITUCION_FILE="$ROOT_DIR/CONSTITUCION.md"
DECISIONS_DIR="$ROOT_DIR/DECISIONS"
DECISIONS_INDEX="$ROOT_DIR/DECISIONS-INDEX.md"
SKILLS_DIR="$ROOT_DIR/skills"
DATA_DIR="$ROOT_DIR/data"

# Paleta de colores ANSI
CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

help_menu() {
  cat <<EOF
${CYAN}======================================================================
 SDD CLI — Protocolo de Desarrollo Guiado por Especificaciones
======================================================================${NC}
Uso: sdd <comando> [argumentos]

${YELLOW}Gestión de Sesión y Concurrencia:${NC}
  lock <modulo> <tarea> [agent-id]  Adquiere un bloqueo atómico en SESSION_LOCK.md
  unlock [agent-id] [modulo]        Libera la sesión activa y calcula hora de fin
  status                            Muestra las sesiones activas y bloqueos vigentes

${YELLOW}Calidad, Sincronización y Gobernanza:${NC}
  check                             Valida frontmatter YAML, links y drift de constitución
  sync                              Regenera determinísticamente CONSTITUCION.md
  adr "<Título de la decisión>"     Crea un nuevo ADR fechado y actualiza el índice
  detect [ruta]                     Detecta el stack tecnológico de forma agnóstica

${YELLOW}Configuración y Automatización:${NC}
  hook install                      Instala el pre-commit hook automático en Git
  init <directorio-destino>         Inicializa SDD con auto-conectores (Cursor, Claude, Copilot)

Ejemplos:
  ./sdd lock "api/orders" "Implementar outbox" "Agent-Dev"
  ./sdd unlock
  ./sdd check
  ./sdd adr "Adopción de UUIDv7"
EOF
}

cmd_status() {
  echo -e "${CYAN}=== Estado de Sesiones en SESSION_LOCK.md ===${NC}"
  if [[ ! -f "$SESSION_LOCK_FILE" ]]; then
    echo "No existe el archivo $SESSION_LOCK_FILE"
    exit 1
  fi
  grep -E "\|.*\|" "$SESSION_LOCK_FILE" | grep -v "AgentID" | grep -v ":---" || echo "No hay registros de sesión."
}

cmd_lock() {
  local module="${1:-}"
  local task="${2:-}"
  local agent_id="${3:-${SDD_AGENT_ID:-Agent-Dev}}"

  if [[ -z "$module" || -z "$task" ]]; then
    echo -e "${RED}Error: Debe especificar módulo y tarea.${NC}" >&2
    echo "Uso: sdd lock <modulo> <tarea> [agent-id]" >&2
    exit 1
  fi

  if grep -q "| \`.*\` | \`$module\` | .* | - | 🔒 Bloqueado |" "$SESSION_LOCK_FILE" 2>/dev/null; then
    echo -e "${RED}❌ CONFLICTO: El módulo '$module' ya se encuentra bloqueado (🔒).${NC}" >&2
    echo "Debe coordinar con el agente activo o esperar su liberación." >&2
    exit 1
  fi

  local now_utc
  now_utc=$(date -u +"%Y-%m-%d %H:%M")

  local temp_file
  temp_file=$(mktemp)
  local new_row="| \`$agent_id\` | \`$module\` | $now_utc | - | 🔒 Bloqueado | $task |"

  awk -v row="$new_row" '
    /\| :--- \| :--- \|/ {
      print $0
      print row
      next
    }
    { print }
  ' "$SESSION_LOCK_FILE" > "$temp_file"

  mv "$temp_file" "$SESSION_LOCK_FILE"
  echo -e "${GREEN}✅ Bloqueo adquirido con éxito:${NC}"
  echo "   Agente : $agent_id"
  echo "   Módulo : $module"
  echo "   Tarea  : $task"
  echo "   Hora   : $now_utc UTC"
}

cmd_unlock() {
  local agent_id="${1:-${SDD_AGENT_ID:-}}"
  local module="${2:-}"
  local now_utc
  now_utc=$(date -u +"%Y-%m-%d %H:%M")

  local temp_file
  temp_file=$(mktemp)
  local updated=0

  while IFS= read -r line; do
    if [[ "$line" =~ 🔒\ Bloqueado ]]; then
      local match=1
      if [[ -n "$agent_id" ]] && ! echo "$line" | grep -q "\`$agent_id\`"; then
        match=0
      fi
      if [[ -n "$module" ]] && ! echo "$line" | grep -q "\`$module\`"; then
        match=0
      fi

      if [[ $match -eq 1 && $updated -eq 0 ]]; then
        line=$(echo "$line" | sed "s/| - | 🔒 Bloqueado |/| $now_utc | ✅ Liberado |/")
        updated=1
      fi
    fi
    echo "$line" >> "$temp_file"
  done < "$SESSION_LOCK_FILE"

  mv "$temp_file" "$SESSION_LOCK_FILE"

  if [[ $updated -eq 1 ]]; then
    echo -e "${GREEN}✅ Sesión liberada con éxito a las $now_utc UTC.${NC}"
  else
    echo -e "${YELLOW}⚠️ No se encontró ninguna sesión activa bloqueada para liberar.${NC}"
  fi
}

# Lógica absorbida de sync-constitution.sh
cmd_sync() {
  echo "Sincronizando constitución desde $SKILLS_DIR..."
  cat <<'EOF' > "$CONSTITUCION_FILE"
# Constitución del Proyecto: Catálogo Normativo de Skills
<!-- ESTE ARCHIVO ES AUTOGENERADO. NO EDITAR DIRECTAMENTE. -->
<!-- Regenerar con: ./sdd sync -->

> **Regla de Oro**: Si una capacidad, procedimiento o invariante no está reflejada
> en una skill catalogada en esta Constitución, **no existe como estándar oficial**.

---

## 📜 Tabla de Habilidades Activas

| Skill / Identificador | Dominio | Criticidad | Alcance | Descripción |
| :--- | :--- | :--- | :--- | :--- |
EOF

  local count=0
  if [[ -d "$SKILLS_DIR" ]]; then
    for skill_file in "$SKILLS_DIR"/*/SKILL.md; do
      if [[ ! -f "$skill_file" ]]; then
        continue
      fi

      local name desc domain criticality scope rel_path
      name=$(awk -F': ' '/^name:/ {print $2; exit}' "$skill_file" | tr -d '\r"' || true)
      desc=$(awk -F': ' '/^description:/ {print $2; exit}' "$skill_file" | tr -d '\r"' || true)
      domain=$(awk -F': ' '/^domain:/ {print $2; exit}' "$skill_file" | tr -d '\r"' || true)
      criticality=$(awk -F': ' '/^criticality:/ {print $2; exit}' "$skill_file" | tr -d '\r"' || true)
      scope=$(awk -F': ' '/^scope:/ {print $2; exit}' "$skill_file" | tr -d '\r"' || true)

      if [[ -n "$name" ]]; then
        rel_path="skills/$(basename "$(dirname "$skill_file")")/SKILL.md"
        echo "| [\`$name\`]($rel_path) | \`${domain:-general}\` | \`${criticality:-medium}\` | \`${scope:-global}\` | $desc |" >> "$CONSTITUCION_FILE"
        count=$((count + 1))
      fi
    done
  fi

  cat <<EOF >> "$CONSTITUCION_FILE"

---

## Invariantes de la Constitución

1. **Obligatoriedad**: Todo agente debe consultar este índice durante la fase *Discovery* del SOP v2.
2. **Sincronización**: Toda modificación o creación de una skill exige ejecutar \`./sdd sync\`.
3. **Total de habilidades indexadas**: $count
EOF

  echo -e "${GREEN}CONSTITUCION.md regenerada con éxito. Habilidades indexadas: $count.${NC}"
}

# Lógica absorbida de validate-skills.sh
cmd_validate_skills() {
  echo "Validando estructura de skills en: $SKILLS_DIR"
  local errors=0

  if [[ ! -d "$SKILLS_DIR" ]]; then
    echo "Error: No existe el directorio de skills en $SKILLS_DIR" >&2
    exit 1
  fi

  shopt -s nullglob
  local skills=("$SKILLS_DIR"/*)
  shopt -u nullglob

  if [[ ${#skills[@]} -eq 0 ]]; then
    echo "No hay skills para validar aún."
    return 0
  fi

  for skill_dir in "${skills[@]}"; do
    if [[ ! -d "$skill_dir" ]]; then
      continue
    fi

    local dir_name skill_file has_start_yaml skill_name
    dir_name=$(basename "$skill_dir")
    skill_file="$skill_dir/SKILL.md"

    if [[ ! -f "$skill_file" ]]; then
      echo -e "${RED}❌ [$dir_name] Falta el archivo SKILL.md${NC}"
      errors=$((errors + 1))
      continue
    fi

    has_start_yaml=$(head -n 1 "$skill_file" | grep -E '^---$' || true)
    if [[ -z "$has_start_yaml" ]]; then
      echo -e "${RED}❌ [$dir_name] Falta el inicio de frontmatter YAML (---)${NC}"
      errors=$((errors + 1))
      continue
    fi

    for field in name description domain scope criticality; do
      if ! grep -q -E "^${field}:" "$skill_file"; then
        echo -e "${RED}❌ [$dir_name] Falta el campo requerido: '$field'${NC}"
        errors=$((errors + 1))
      fi
    done

    skill_name=$(awk -F': ' '/^name:/ {print $2; exit}' "$skill_file" | tr -d '\r"' || true)
    if [[ ! "$skill_name" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]]; then
      echo -e "${RED}❌ [$dir_name] El campo name ('$skill_name') debe ser kebab-case.${NC}"
      errors=$((errors + 1))
    fi

    echo -e "${GREEN}✅ [$dir_name] Estructura y frontmatter válidos.${NC}"
  done

  if [[ $errors -gt 0 ]]; then
    echo -e "${RED}Se encontraron $errors errores de validación.${NC}" >&2
    exit 1
  fi
}

cmd_check() {
  echo -e "${CYAN}Ejecutando verificación integral SDD...${NC}"
  cmd_validate_skills
  
  echo ""
  cmd_sync
  
  if ! git -C "$ROOT_DIR" diff --quiet CONSTITUCION.md 2>/dev/null; then
    echo -e "${RED}❌ Drift detectado: CONSTITUCION.md no estaba sincronizada.${NC}" >&2
    exit 1
  fi
  echo -e "${GREEN}✅ Verificación exitosa. Repositorio 100% en regla.${NC}"
}

# Lógica absorbida de new-decision.sh
cmd_adr() {
  if [[ $# -lt 1 ]]; then
    echo -e "${RED}Error: Debe proveer un título para el ADR.${NC}" >&2
    echo "Uso: sdd adr \"Título de la decisión\"" >&2
    exit 1
  fi

  local title="$1"
  local today slug filename filepath
  today=$(date +"%Y-%m-%d")
  slug=$(echo "$title" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-//;s/-$//')
  filename="${today}-${slug}.md"
  filepath="$DECISIONS_DIR/$filename"

  mkdir -p "$DECISIONS_DIR"
  if [[ -f "$filepath" ]]; then
    echo -e "${RED}Error: Ya existe el archivo $filepath${NC}" >&2
    exit 1
  fi

  cat <<EOF > "$filepath"
# ADR: $title
- **Fecha**: $today
- **Estado**: Propuesto <!-- Propuesto | Aceptado | Superado | Deprecado -->
- **Autor(es)**: Agent-Arch / Equipo

## Contexto y Planteo del Problema
Describir la situación técnica o de dominio que motiva la decisión.

## Opciones Consideradas
1. **Opción 1**: Descripción.
2. **Opción 2**: Descripción.

## Decisión Adoptada
Explicar qué opción se elige y la justificación técnica fundamentada en la Jerarquía de Precedencia.

## Consecuencias
### Positivas
- Beneficio 1.

### Negativas / Trade-offs
- Concesión o complejidad asumida.

## Cumplimiento y Verificación
Cómo los agentes y el pipeline verificarán que esta decisión se respete en el código.
EOF

  echo -e "${GREEN}Creado nuevo ADR: $filepath${NC}"

  if [[ ! -f "$DECISIONS_INDEX" ]]; then
    cat <<'EOF' > "$DECISIONS_INDEX"
# Índice Maestro de Decisiones Arquitectónicas (ADR)

| Fecha | Título / Archivo | Estado | Resumen |
| :--- | :--- | :--- | :--- |
EOF
  fi

  echo "| $today | [$title](DECISIONS/$filename) | Propuesto | Nueva decisión de arquitectura |" >> "$DECISIONS_INDEX"
  echo -e "${GREEN}Actualizado índice en $DECISIONS_INDEX${NC}"
}

cmd_detect() {
  local target="${1:-.}"
  local matrix_file="$DATA_DIR/tech-stack-detection.json"
  
  echo -e "${CYAN}Detectando stack tecnológico en: $target${NC}"
  local detected=0

  if [[ -f "$target/package.json" ]]; then
    echo -e "${GREEN}  ✓ Detectado ecosistema: Node.js / TypeScript (package.json)${NC}"
    detected=1
  fi
  if [[ -f "$target/go.mod" ]]; then
    echo -e "${GREEN}  ✓ Detectado ecosistema: Go (go.mod)${NC}"
    detected=1
  fi
  if [[ -f "$target/pyproject.toml" || -f "$target/requirements.txt" ]]; then
    echo -e "${GREEN}  ✓ Detectado ecosistema: Python (pyproject.toml / requirements.txt)${NC}"
    detected=1
  fi
  if [[ -f "$target/Cargo.toml" ]]; then
    echo -e "${GREEN}  ✓ Detectado ecosistema: Rust (Cargo.toml)${NC}"
    detected=1
  fi
  if [[ -f "$target/composer.json" ]]; then
    echo -e "${GREEN}  ✓ Detectado ecosistema: PHP (composer.json)${NC}"
    detected=1
  fi
  if [[ -f "$target/pom.xml" || -f "$target/build.gradle" ]]; then
    echo -e "${GREEN}  ✓ Detectado ecosistema: Java / JVM (pom.xml / build.gradle)${NC}"
    detected=1
  fi

  if [[ $detected -eq 0 ]]; then
    echo -e "${YELLOW}  ⚠️ No se detectó un stack estándar conocido. Stack genérico.${NC}"
  fi
}

cmd_hook_install() {
  local git_dir
  git_dir=$(git -C "$ROOT_DIR" rev-parse --git-dir 2>/dev/null || true)
  if [[ -z "$git_dir" ]]; then
    echo -e "${RED}Error: No se encontró directorio .git en $ROOT_DIR${NC}" >&2
    exit 1
  fi

  if [[ "$git_dir" != /* ]]; then
    git_dir="$ROOT_DIR/$git_dir"
  fi

  mkdir -p "$git_dir/hooks"
  local hook_file="$git_dir/hooks/pre-commit"

  cat <<'EOF' > "$hook_file"
#!/usr/bin/env bash
set -euo pipefail
REPO_ROOT="$(git rev-parse --show-toplevel)"
if [[ -x "$REPO_ROOT/sdd" ]]; then
  echo "🔍 [SDD Hook] Verificando estándares y constitución..."
  "$REPO_ROOT/sdd" check
elif [[ -x "$REPO_ROOT/scripts/sdd" ]]; then
  echo "🔍 [SDD Hook] Verificando estándares y constitución..."
  "$REPO_ROOT/scripts/sdd" check
fi
EOF

  chmod +x "$hook_file"
  echo -e "${GREEN}✅ Pre-commit hook instalado en $hook_file.${NC}"
}

# Lógica absorbida de bootstrap.sh con auto-instalación de conectores
cmd_init() {
  local target="${1:-.}"
  local project_name="${2:-$(basename "$(realpath "$target")")}"

  echo -e "${CYAN}============================================================${NC}"
  echo -e "${CYAN} Inicializando Protocolo SDD en: $target${NC}"
  echo -e "${CYAN} Proyecto: $project_name${NC}"
  echo -e "${CYAN}============================================================${NC}"

  mkdir -p "$target"/{.github/workflows,contexto,skills,agentes,RULES,DECISIONS,MAPS,workflows,checklists,templates,scripts,data}

  # Copiar archivos normativos
  for file in AGENTS.md SESSION_LOCK.md ANTI-PATTERNS.md DECISIONS-INDEX.md; do
    if [[ -f "$ROOT_DIR/$file" && ! -f "$target/$file" ]]; then
      cp "$ROOT_DIR/$file" "$target/$file"
      echo "  [CREADO] $target/$file"
    fi
  done

  # Copiar contexto consolidado
  if [[ -f "$ROOT_DIR/contexto/CONTEXTO.md" && ! -f "$target/contexto/CONTEXTO.md" ]]; then
    cp "$ROOT_DIR/contexto/CONTEXTO.md" "$target/contexto/CONTEXTO.md"
    echo "  [CREADO] $target/contexto/CONTEXTO.md"
  fi

  # Copiar diccionarios agnósticos
  if [[ -d "$ROOT_DIR/data" ]]; then
    cp -rn "$ROOT_DIR/data/"* "$target/data/" 2>/dev/null || true
  fi

  # Copiar templates
  if [[ -d "$ROOT_DIR/templates" ]]; then
    cp -rn "$ROOT_DIR/templates/"* "$target/templates/" 2>/dev/null || true
  fi

  # Instalar CLI ejecutable en scripts y raíz
  cp "$ROOT_DIR/scripts/sdd" "$target/scripts/sdd"
  chmod +x "$target/scripts/sdd"
  ln -sf "scripts/sdd" "$target/sdd" 2>/dev/null || cp "$ROOT_DIR/scripts/sdd" "$target/sdd"
  chmod +x "$target/sdd"

  # Generar auto-conectores para IAs (Cursor, Claude Code, GitHub Copilot)
  cat <<'EOF' > "$target/.cursorrules"
# Protocolo SDD: Instrucciones Mandatorias para Cursor
Este repositorio opera bajo el Protocolo SDD definido en AGENTS.md.
1. Consulta AGENTS.md y CONSTITUCION.md antes de actuar.
2. Ejecuta ./sdd lock "<modulo>" "<tarea>" antes de editar.
3. Todo código generado debe llevar // @ai-gen (Regla AI-ATTR-01).
4. Al finalizar la tarea, ejecuta ./sdd unlock.
5. Pasa ./sdd check antes de confirmar cambios.
EOF

  cat <<'EOF' > "$target/CLAUDE.md"
# Claude Code Guidelines: Spec-Driven Development (SDD)
This repository strictly enforces the SDD protocol in AGENTS.md.
- Run `./sdd lock "<module>" "<task>"` before editing code. Run `./sdd unlock` when finished.
- Label all generated code with `// @ai-gen` (Rule AI-ATTR-01).
- Validate with `./sdd check` before finishing tasks.
EOF

  if [[ -f "$ROOT_DIR/.github/copilot-instructions.md" && ! -f "$target/.github/copilot-instructions.md" ]]; then
    cp "$ROOT_DIR/.github/copilot-instructions.md" "$target/.github/copilot-instructions.md"
  fi

  # Instalar git hook si es repo git
  if [[ -d "$target/.git" ]]; then
    (cd "$target" && "$target/sdd" hook install 2>/dev/null || true)
  fi

  echo ""
  echo -e "${GREEN}✅ Protocolo SDD inicializado con éxito en $target.${NC}"
  echo "   - CLI ejecutable: $target/sdd"
  echo "   - Conector Cursor: $target/.cursorrules"
  echo "   - Conector Claude: $target/CLAUDE.md"
  echo "   - Conector Copilot: $target/.github/copilot-instructions.md"
}

# Despachador principal
if [[ $# -eq 0 ]]; then
  help_menu
  exit 0
fi

action="$1"
shift

case "$action" in
  lock)
    cmd_lock "$@"
    ;;
  unlock)
    cmd_unlock "$@"
    ;;
  status)
    cmd_status "$@"
    ;;
  check)
    cmd_check "$@"
    ;;
  sync)
    cmd_sync "$@"
    ;;
  adr)
    cmd_adr "$@"
    ;;
  detect)
    cmd_detect "$@"
    ;;
  hook)
    if [[ "${1:-}" == "install" ]]; then
      cmd_hook_install
    else
      echo "Uso: sdd hook install" >&2
      exit 1
    fi
    ;;
  init)
    cmd_init "$@"
    ;;
  help|--help|-h)
    help_menu
    ;;
  *)
    echo -e "${RED}Comando desconocido: $action${NC}" >&2
    help_menu
    exit 1
    ;;
esac
